{
  "group": "ipython",
  "caseCount": 5,
  "cases": [
    {
      "name": "stdout-stderr-result-ordering",
      "code": "print('out')",
      "mockResults": [
        {
          "status": "ok",
          "stdout": "out\n",
          "stderr": "err\n",
          "durationMs": 123,
          "result": "42"
        }
      ],
      "provisionerCalls": {
        "ensure": 1,
        "execute": 1,
        "kill": 0
      },
      "result": {
        "ok": true,
        "isError": false,
        "outputText": "out\n\nerr\n\n42"
      }
    },
    {
      "name": "error-status-traceback",
      "code": "1/0",
      "mockResults": [
        {
          "status": "error",
          "stdout": "before\n",
          "stderr": "",
          "error": {
            "ename": "ZeroDivisionError",
            "evalue": "division by zero",
            "traceback": [
              "Traceback (most recent call last):",
              "  File ...: division by zero"
            ]
          },
          "durationMs": 5
        }
      ],
      "provisionerCalls": {
        "ensure": 1,
        "execute": 1,
        "kill": 0
      },
      "result": {
        "ok": true,
        "isError": true,
        "outputText": "before\n\nTraceback (most recent call last):\n  File ...: division by zero"
      }
    },
    {
      "name": "empty-output",
      "code": "x = 1",
      "mockResults": [
        {
          "status": "ok",
          "stdout": "",
          "stderr": "",
          "durationMs": 123
        }
      ],
      "provisionerCalls": {
        "ensure": 1,
        "execute": 1,
        "kill": 0
      },
      "result": {
        "ok": true,
        "isError": false,
        "outputText": ""
      }
    },
    {
      "name": "background-output",
      "code": "import time; time.sleep(0.01)",
      "mockResults": [
        {
          "status": "ok",
          "stdout": "x",
          "stderr": "",
          "durationMs": 123,
          "backgroundOutput": "late output\nfrom background"
        }
      ],
      "provisionerCalls": {
        "ensure": 1,
        "execute": 1,
        "kill": 0
      },
      "result": {
        "ok": true,
        "isError": false,
        "outputText": "x\n[background output (unattributed)]\nlate output\nfrom background"
      }
    },
    {
      "name": "aborted-status",
      "code": "import time; time.sleep(10)",
      "mockResults": [
        {
          "status": "aborted",
          "stdout": "partial output",
          "stderr": "",
          "durationMs": 123
        }
      ],
      "provisionerCalls": {
        "ensure": 1,
        "execute": 1,
        "kill": 0
      },
      "result": {
        "ok": true,
        "isError": true,
        "outputText": "partial output"
      }
    }
  ]
}
