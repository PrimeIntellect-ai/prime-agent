+                  "when": { "output": "verdict", "path": "approved", "op": "eq", "value": false } },
+                { "from": "reviewing", "to": "monitoring", "on": "settle",
+                  "when": { "output": "verdict", "path": "approved", "op": "eq", "value": true } },
+                { "from": "fixing", "to": "reviewing", "on": "settle" },
