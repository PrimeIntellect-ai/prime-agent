+    def store(self, root: Path, name: str, description: str, spec: dict[str, Any]) -> Path:
+        directory = root / name
+        directory.mkdir(parents=True, exist_ok=True)
+        path = directory / "MACHINE.md"
+        path.write_text(
+            machine_file_text(
